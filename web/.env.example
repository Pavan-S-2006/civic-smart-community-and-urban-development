# CivicPulse — Firebase Environment Variables
# Copy this file to .env.local and fill in your actual Firebase credentials
# from: https://console.firebase.google.com → Project Settings → Your Apps → SDK setup

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI Auto-Tagging & Suggestion Engine (Google Gemini / AI key)
VITE_GEMINI_API_KEY=

